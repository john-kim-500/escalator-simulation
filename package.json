{
  "name": "escalator-simulator-web",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Contributor tools: browser engine tests and style checks. The GUI itself needs no build step.",
  "scripts": {
    "test": "node --test 'web/tests/*.test.mjs'",
    "lint": "eslint . && ruff check .",
    "lint:fix": "ruff check --fix --exit-zero . && eslint --fix .",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pyodide": "314.0.7"
  }
}
